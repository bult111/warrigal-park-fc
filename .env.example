# Warrigal Park FC — environment configuration example
# Copy this file to `.env` and adjust the values for your local machine.

# Flask development/debug mode ("1" enables debug and auto-reload).
FLASK_ENV=development
FLASK_DEBUG=1

# Secret key used by Flask for session signing and flash messages.
# Change this to a long random value in a real deployment.
SECRET_KEY=change-me-to-a-random-secret

# Path to the SQLite database file.
# A relative path is resolved against the Flask instance folder (./instance).
DATABASE=warrigal_park_fc.db
